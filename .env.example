# ============================================================
#  METAMORPHOO - Variables d'environnement (copier en .env.local)
#  Ces valeurs restent SECRETES : ne jamais les publier sur GitHub
# ============================================================

# --- Google Apps Script (formulaires -> Google Sheets) ---------
# URL du Web App déployé (voir docs/02-GOOGLE-FORMS-ET-SUIVI.md)
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=

# --- Paiement : FlexPaie --------------------------------------
# Tableau de bord : https://flexpaie.com
NEXT_PUBLIC_FLEXPAIE_MERCHANT=
NEXT_PUBLIC_FLEXPAIE_API_URL=https://api.flexpaie.com/v1
FLEXPAIE_API_KEY=

# --- Paiement : GeneraPay (SaaS Metamorphoo en dev) ----------
NEXT_PUBLIC_GENERAPAY_API_URL=https://api.generapay.cd/v1
NEXT_PUBLIC_GENERAPAY_MERCHANT=
GENERAPAY_API_KEY=

# --- Paiement : Mobile Money / RDC ---------------------------
NEXT_PUBLIC_MPESA_NUMBER=
NEXT_PUBLIC_AIRTEL_MONEY_NUMBER=
NEXT_PUBLIC_ORANGE_MONEY_NUMBER=

# --- Virement bancaire ---------------------------------------
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT=
NEXT_PUBLIC_BANK_SWIFT=

# --- YouTube -------------------------------------------------
# ID de la chaîne (commence par UC...). Trouvable sur la chaîne > A propos
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=

# --- E-mail de notification (Google Forms/Apps Script) -------
NEXT_PUBLIC_CONTACT_EMAIL=contactmetamorphoo@gmail.com
